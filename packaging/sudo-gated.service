[Unit]
Description=sudo-gate approval daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/sbin/sudo-gated --config /etc/sudo-gate/config.json --socket /run/sudo-gate/sock
Restart=on-failure
RestartSec=1

# Hardening (adjust if it breaks something)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/sudo-gate /var/log /etc/sudo-gate

[Install]
WantedBy=multi-user.target
