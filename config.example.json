{
  "telegram": {
    "bot_token": "__REDACTED__",
    "allowed_user_id": 0,
    "allowed_chat_id": null,
    "poll_interval_ms": 1500,
    "result_mode": "summary",
    "result_max_chars": 1200
  },
  "security": {
    "hmac_secret_hex": "__GENERATE_32_BYTES_HEX__",
    "request_ttl_seconds": 90,
    "max_request_bytes": 8192,
    "max_reason_len": 200,
    "max_arg_count": 16,
    "max_arg_len": 512,
    "max_pending_requests": 32,
    "per_uid_max_requests": 5,
    "per_uid_window_seconds": 60,
    "command_timeout_seconds": 60,
    "requester_allow_uids": []
  },
  "policy": {
    "mode": "allowlist",
    "allow": [
      {
        "exe": "/usr/bin/apt",
        "args_prefix": ["update"]
      },
      {
        "exe": "/usr/bin/systemctl",
        "args_prefix": ["restart", "nginx"]
      }
    ],
    "deny": [
      {
        "kind": "exe",
        "value": "/bin/sh"
      },
      {
        "kind": "exe",
        "value": "/bin/bash"
      },
      {
        "kind": "exe",
        "value": "/usr/bin/python3"
      },
      {
        "kind": "exe",
        "value": "/usr/bin/env"
      }
    ]
  }
}
